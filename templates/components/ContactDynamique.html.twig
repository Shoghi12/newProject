<div {{ attributes }} data-controller="live">
    <div>
        <label for="name">Nom :</label>
        <input 
            type="text" 
            id="name" 
            name="name"
            value="{{ name }}"
            data-model="name"
            data-action="input->live#update"
        >
    </div>

    {% if name|lower == 'john' %}
        <div>
            <label for="email">Email :</label>
            <input 
                type="email" 
                id="email" 
                name="email"
                value="{{ email }}"
                data-model="email"
            >
        </div>
    {% endif %}
</div>