
{% extends 'base.html.twig' %}
{% block stylesheets %}
{% endblock %}
{% block body %}
 

<h2>Démo Live Component : Bouton simple</h2>
{{ component('App\\Twig\\Components\\ShowMessageComponent') }}

{# {{ component('App\\Twig\\Components\\Alert') }} #}

{{ component('ContactDynamique') }}
<br><br><br>


    <h1>Entrez votre nom</h1>
    
    <div {{ stimulus_controller('dynamic_form') }}>
        <div>
            <label for="name">Nom :</label>
            <input 
                type="text" 
                id="name" 
                name="name"
                {{ stimulus_target('dynamic_form', 'nameInput') }}
                {{ stimulus_action('dynamic_form', 'onNameInput', 'input') }}
            >
        </div>

        <div {{ stimulus_target('dynamic_form', 'emailContainer') }} hidden>
            <label for="email">Email :</label>
            <input 
                type="email" 
                id="email" 
                name="email"
            >
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
   




