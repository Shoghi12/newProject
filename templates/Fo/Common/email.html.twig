{# templates/email/welcome.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Bienvenue cher utilisateur!</title>
    <style>
        body { font-family: Arial, sans-serif; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .footer { font-size: 12px; color: #888; margin-top: 30px; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Bonjour,</h2>
        <p>
            Nous sommes ravis de vous compter parmi nos membres !
        </p>
        <p>
            Voici un résumé de vos informations :
        </p>
        <ul>
            <li>Email : votre email</li>
            <li>Date d'inscription : votre date d'inscripation</li>
        </ul>
        <p>
            N'hésitez pas à nous contacter si vous avez des questions.
        </p>
        <p>
            Cordialement,<br>
            L'équipe Support
        </p>
        <div class="footer">
            &copy; {{ "now"|date("Y") }} Votre Société. Tous droits réservés.
        </div>
    </div>
</body>
</html>