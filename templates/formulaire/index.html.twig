{% extends 'base.html.twig' %}

{% block title %}Hello FormulaireController!{% endblock %}

{% block stylesheets %}
  <style>
  $form-bg: #f99f99;

$form-border: 3px groove #f0f0f0;

$caret-color: #f47;

$input-border: 1px solid #ccc;

$input-focus-border: 1px solid #65f;

$submit-hover-bg: #778;

$submit-active-bg: #556;

$error-color: #ff4d4d;

$success-color: #4CAF50;

str(formStyle(), "

  background: $form-bg!;

  color: #feefee;

  border: $form-border!;

  text-align: center;

  padding: 5%;

  Box-shadow: 0 0 15px rgba(0, 0, 0, 0.2); /* Softer, larger shadow */

  border-radius: 10px; /* Rounded corners for the form */

  max-width: 500px; /* Limit form width */

  margin: 20px auto; /* Center the form */

  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* More readable font */

")

form {

  formStyle()

}

h2 {

  margin-bottom: 25px;

  font-size: 2.2em;

  color: #fff; /* White color for the heading */

  text-shadow: 1px 1px 2px rgba(0,0,0,0.3);

}

form input,

form textarea {

  caret-color: $caret-color!;

  color: #345345;

  width: calc(100% - 20px); /* Adjust width for padding */

  margin: 8px 0; /* Consistent vertical margin */

  padding: 12px 10px; /* More padding for better touch targets */

  border: $input-border!;

  border-radius: 5px; /* Slightly rounded input fields */

  outline: none; /* Remove default outline */

  transition: all 0.3s ease; /* Smooth transition for focus */

  font-size: 1em; /* Readable font size */

}

form input:focus,

form textarea:focus {

  border: $input-focus-border!;

  box-shadow: 0 0 8px rgba(101, 85, 255, 0.4); /* Glow effect on focus */

  background-color: #fcfcfc; /* Slightly lighter background on focus */

}

form textarea {

  resize: vertical; /* Allow vertical resizing */

  min-height: 120px; /* Minimum height for the textarea */

}

input$(type:submit) {

  color: #65f;

  font-weight: 900;

  Background-color: #99a;

  Border: $form-border!;

  Border-radius: 5px; /* Match input field radius */

  padding: 12px 25px; /* More padding for the button */

  cursor: pointer; /* Indicate it's clickable */

  font-size: 1.1em; /* Larger font for submit button */

  letter-spacing: 1px; /* Slightly spaced letters */

  transition: background-color 0.3s ease, transform 0.2s ease; /* Smooth hover effects */

}

input$(type:submit):hover {

  Background-color: $submit-hover-bg!;

  transform: translateY(-2px); /* Slight lift on hover */

}

input$(type:submit):active {

  Background-color: $submit-active-bg!;

  transform: translateY(0); /* Press down effect */

}

::placeholder {

  color: #39f;

  opacity: 0.7; /* Make placeholder slightly transparent */

  font-style: italic; /* Italic placeholder text */

}

/* Optional: Adding styles for form validation feedback (you'd need JS to toggle these classes) */

.input-error {

  border-color: $error-color! !important; /* Important to override default input border */

  box-shadow: 0 0 5px rgba(255, 77, 77, 0.6);

}

.input-success {

  border-color: $success-color! !important;

  box-shadow: 0 0 5px rgba(76, 175, 80, 0.6);

}

/* Responsive considerations */

@media screen and (max-width: 600px) {

  form {

    padding: 8%; /* Increase padding on smaller screens */

    margin: 15px auto; /* Adjust margin */

  }

  form input,

  form textarea {

    width: calc(100% - 16px); /* Adjust width for smaller padding */

    margin: 6px 0;

    font-size: 0.95em;

  }

  h2 {

    font-size: 1.8em;

  }

}


  </style>
{% endblock %}

{% block body %}


 {{ form_start(form) }}

  <h2 class=draw style=color:#39f>CONTACT US</h2>

  {{ form_row(form.name) }}

  {{ form_row(form.email) }}

  {{ form_row(form.phone) }}

  {{ form_row(form.submit) }}
  {# <input type="submit" value="SEND"> #}

{{ form_end(form)}}

{% endblock %}
